+func end_story_travel() -> void:
+    _clear_story_travel_state()
+    _selected_route.clear()
+    queue_redraw()
+
+func is_story_travel_active() -> bool:
+    return _story_travel_active
+
+func _build_story_travel_points(path: Array[String]) -> Array[Vector2]:
+    var result: Array[Vector2] = []
+    if path.size() < 2:
+        return result
+
+    for i in range(path.size() - 1):
+        var segment: Array[Vector2] = _route_draw_points(path[i], path[i + 1])
+        for point in segment:
+            if result.is_empty() or result.back().distance_to(point) > 0.01:
+                result.append(point)
+    return result
+
+func _polyline_length(points: Array[Vector2]) -> float:
+    var total: float = 0.0
+    for i in range(points.size() - 1):
+        total += points[i].distance_to(points[i + 1])
+    return total
+
+func _point_on_story_polyline(distance: float) -> Vector2:
+    if _story_travel_points.is_empty():
+        return Vector2.ZERO
+    if _story_travel_points.size() == 1:
+        return _story_travel_points[0]
+
+    var remaining: float = clamp(distance, 0.0, _story_travel_total_length)
+    for i in range(_story_travel_points.size() - 1):
+        var from_point: Vector2 = _story_travel_points[i]
+        var to_point: Vector2 = _story_travel_points[i + 1]
+        var segment_length: float = from_point.distance_to(to_point)
+        if segment_length <= 0.0:
+            continue
+        if remaining <= segment_length:
+            return from_point.lerp(to_point, remaining / segment_length)
+        remaining -= segment_length
+    return _story_travel_points.back()
+
+func _update_story_travel(delta: float) -> void:
+    _story_travel_elapsed += max(0.0, delta)
+    var ratio: float = clamp(
+        _story_travel_elapsed / max(0.1, _story_travel_duration_current),
+        0.0,
+        1.0
+    )
+    # Smooth acceleration/deceleration while keeping the route distance uniform.
+    var eased_ratio: float = ratio * ratio * (3.0 - 2.0 * ratio)
+    _story_travel_position = _point_on_story_polyline(
+        _story_travel_total_length * eased_ratio
+    )
+    queue_redraw()
+
+    if ratio >= 1.0:
+        _story_travel_active = false
+        story_travel_finished.emit()
+
+func _clear_story_travel_state() -> void:
+    _story_travel_active = false
+    _story_travel_visible = false
+    _story_travel_points.clear()
+    _story_travel_path.clear()
+    _story_travel_position = Vector2.ZERO
+    _story_travel_elapsed = 0.0
+    _story_travel_duration_current = 0.0
+    _story_travel_total_length = 0.0
